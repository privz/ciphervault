{
  "manifest_version": 3,
  "name": "CipherVault",
  "short_name": "CipherVault",
  "version": "1.0.0",
  "description": "Local AES-256-GCM encryption for private messages. Your data stays in your browser.",

  "action": {
    "default_title": "CipherVault",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  }
}