{
  "manifest_version": 3,
  "name": "CipherVault",
  "short_name": "CipherVault",
  "version": "1.1.0",
  "minimum_chrome_version": "102",
  "description": "Local AES-256-GCM encryption with profiles, Quick Cipher hotkey, and temporary draft recovery.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "CipherVault",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "quick-cipher": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Encrypt or decrypt the selected text with CipherVault"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
